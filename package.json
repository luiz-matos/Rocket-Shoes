{
  "name": "rocket-shoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node -e \"require('fs').copyFileSync('server.json', 'db.json')\" && json-server db.json --host 127.0.0.1 --port 3333",
    "build": "eslint . && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "polished": "^4.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0",
    "redux-saga": "^1.5.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "json-server": "0.17.4",
    "prettier": "^3.9.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
